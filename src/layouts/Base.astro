---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = 'Portfolio of Alex Morgan, senior product designer.' } = Astro.props;
const siteName = 'Alex Morgan';
const pageTitle = title ? `${title} — ${siteName}` : `${siteName} — Senior Product Designer`;

const nav = [
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const path = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href="/" class="site-name">{siteName}</a>
        <nav class="site-nav" aria-label="Main">
          <ul role="list">
            {nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="site-footer-info">
          <p>© {new Date().getFullYear()} Pavlo Havrylov</p>
          <p>Based in Lviv, Ukraine</p>
        </div>
        <ul role="list">
          <li><a href="#">LinkedIn</a></li>
          <li><a href="#">Email</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
