---
import Base from '../layouts/Base.astro';
---

<Base title="Contact">
  <header class="page-header contact container">
    <h1>Let's talk.</h1>
    <p class="lede">
      Placeholder text. I'm open to senior and lead product design roles, as well as select freelance projects.
    </p>
    <a class="contact-email" href="mailto:hello@example.com">hello@example.com</a>

    <ul role="list" class="list-table measure contact-links">
      <li><span>LinkedIn</span><a href="https://www.linkedin.com/">linkedin.com/in/username</a></li>
      <li><span>Read.cv</span><a href="https://read.cv/">read.cv/username</a></li>
      <li><span>Location</span><span class="muted">City, Country</span></li>
    </ul>
  </header>
</Base>
